<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/sherpa/db" VERSION="20260630" COMMENT="XMLDB file for Moodle admin/tool/sherpa"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="tool_sherpa_sources" COMMENT="Sources which Sherpa uses to provide support.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="url" TYPE="char" LENGTH="1333" NOTNULL="true" SEQUENCE="false" COMMENT="The URL of the source."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="tool_sherpa_placement" COMMENT="Placements which connect a location in the user interface to a source.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="type" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="The type of the placement, see the constants in the placement class."/>
        <FIELD NAME="source" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The source this placement points to."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="source" TYPE="foreign" FIELDS="source" REFTABLE="tool_sherpa_sources" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
