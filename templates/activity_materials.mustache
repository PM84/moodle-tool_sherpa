{{!
    @template tool_sherpa/activity_materials

    Supporting materials (tutorials and mocked example template tiles) injected into the activity
    chooser info panel. The reasoning and usage examples are discussed in the chat, so this panel
    only shows the materials.

    Example context (json):
    {
        "hastutorials": true,
        "tutorials": [{"label": "Tutorial: Wiki", "url": "https://example.org/"}],
        "hastemplates": true,
        "templates": [{"title": "Wiki template", "summary": "Ready-made wiki.", "image": ""}]
    }
}}
<div class="sherpa-materials border-top mt-3 pt-3">
    {{#hastutorials}}
        <h6>{{#str}} helpchooser_tutorialstitle, tool_sherpa {{/str}}</h6>
        <ul class="list-unstyled">
            {{#tutorials}}
                <li>
                    <a href="{{url}}" target="_blank" rel="noopener noreferrer">
                        {{label}} <span class="text-muted small">{{#str}} opensinnewtab, tool_sherpa {{/str}}</span>
                    </a>
                </li>
            {{/tutorials}}
        </ul>
    {{/hastutorials}}
    {{#hastemplates}}
        <h6>{{#str}} helpchooser_templatestitle, tool_sherpa {{/str}}</h6>
        <div class="sherpa-tiles d-flex flex-wrap gap-3">
            {{#templates}}
                {{> tool_sherpa/template_tile }}
            {{/templates}}
        </div>
    {{/hastemplates}}
</div>
