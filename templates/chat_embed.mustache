{{!
    @template tool_sherpa/chat_embed

    Container for the reactive block_ai_chat main component, embedded inside the Sherpa modal.
    Mirrors the structure expected by block_ai_chat/components/main (see mod_aichat/embedded_modal).

    Context variables required for this template:
    * uniqueid A page unique id for the main element.

    Example context (json):
    {
        "uniqueid": "tool_sherpa_chat_1"
    }
}}
<div class="block_ai_chat_modal embedded tool-sherpa-chat-embed">
    <div class="modal-dialog modal-dialog-embedded" data-region="modal" tabindex="0"
        data-block_aichat-element="mainelement" data-id="{{uniqueid}}">
        <div class="modal-content modal-content-embedded">
            <div class="modal-header modal-header-embedded d-flex align-items-start" data-region="header">
                <div data-block_ai_chat-element="titleareaplaceholder">
                    <h5 class="modal-title modal-title-embedded text-truncate" data-region="title"></h5>
                </div>
            </div>
            <div class="modal-body modal-body-embedded" data-region="body">
                <div class="block_ai_chat_modal_body" data-block_ai_chat-component="contentarea"></div>
            </div>
        </div>
    </div>
</div>
