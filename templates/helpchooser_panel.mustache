{{!
    @template tool_sherpa/helpchooser_panel

    The body of the Sherpa help chooser modal: an embedded block_ai_chat conversation on the left
    and the reused core activity chooser on the right. As the conversation progresses, the chooser
    list is filtered to the activities the assistant currently recommends.

    Example context (json):
    {
    }
}}
<div class="sherpa-helpchooser">
    <div class="sherpa-chat mb-3" data-region="sherpa-chat">
        <p class="text-muted small mb-2">{{#str}} helpchooser_intro, tool_sherpa {{/str}}</p>
        <div class="sherpa-chat-container" data-region="sherpa-chat-container"></div>
        <div class="sherpa-chat-status text-muted small mt-1" data-region="sherpa-status"
            role="status" aria-live="polite"></div>
    </div>
    <hr aria-hidden="true">
    <div data-region="sherpa-chooser"></div>
</div>
