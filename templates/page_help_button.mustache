{{!
    @template tool_sherpa/page_help_button

    Floating page level help button. Opens the Sherpa modal for the tutorials mapped to the current
    page's body id. Populated by the tool_sherpa/page_help_trigger AMD module.

    Context variables required for this template:
    * bodyid The HTML body id of the current page.
    * contextid The current context id.
    * title The modal title.
    * label The visible button label / aria-label.
    * chatavailable Whether the chat region is available.
    * showmaterials Whether the materials region is enabled.

    Example context (json):
    {
        "bodyid": "page-course-view-topics",
        "contextid": 42,
        "title": "Help for this page",
        "label": "Help for this page",
        "chatavailable": true,
        "showmaterials": true
    }
}}
<div class="tool-sherpa-page-help">
    <button type="button"
        class="btn btn-info rounded-pill shadow tool-sherpa-page-help-button"
        data-action="tool-sherpa-page-help"
        data-bodyid="{{bodyid}}"
        data-contextid="{{contextid}}"
        data-title="{{title}}"
        data-chatavailable="{{#chatavailable}}1{{/chatavailable}}{{^chatavailable}}0{{/chatavailable}}"
        data-showmaterials="{{#showmaterials}}1{{/showmaterials}}{{^showmaterials}}0{{/showmaterials}}"
        aria-haspopup="dialog"
        aria-label="{{label}}">
        {{#pix}}help, core{{/pix}}
        <span class="ms-1">{{label}}</span>
    </button>
</div>
