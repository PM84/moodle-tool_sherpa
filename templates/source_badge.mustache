{{!
    @template tool_sherpa/source_badge

    Bootstrap badge representing a mapped source (url).

    Data attributes required for JS:
    * data-action="mapping-delete"
    * data-mapping-id

    Context variables required for this template:
    * url - The full source URL (used as the unlink label).
    * urlshort - The source URL shortened for display.
    * unlink - Whether to show the unlink control.
    * mappingid - The mapping id (used when unlinking).

    Example context (json):
    {
        "url": "https://example.com/docs",
        "urlshort": "https://example.com/docs",
        "unlink": true,
        "mappingid": 7
    }
}}
<span class="tool_sherpa-badge">
    <span class="badge bg-primary text-white">
        {{urlshort}}
        {{#unlink}}
            <a href="#" role="button" class="tool_sherpa-unlink" data-action="mapping-delete"
                data-mapping-id="{{mappingid}}" data-mapping-label="{{url}}"
                title="{{#str}}unlink, tool_sherpa{{/str}}" aria-label="{{#str}}unlink, tool_sherpa{{/str}}">
                {{#pix}}t/delete, core{{/pix}}
            </a>
        {{/unlink}}
    </span>
</span>
<br>
