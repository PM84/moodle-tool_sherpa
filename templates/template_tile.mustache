{{!
    @template tool_sherpa/template_tile

    A mocked "course tile" representing an example template for an activity. As there are no real
    templates in the demo, the tile is purely informational (a "Demo" badge, no action).

    Example context (json):
    {
        "title": "Wiki template",
        "summary": "A ready-made example for the Wiki activity.",
        "image": ""
    }
}}
<div class="card sherpa-template-tile">
    {{#image}}
        <img class="card-img-top" src="{{image}}" alt="" aria-hidden="true">
    {{/image}}
    {{^image}}
        <div class="sherpa-tile-placeholder card-img-top" aria-hidden="true"></div>
    {{/image}}
    <div class="card-body">
        <span class="badge bg-secondary">{{#str}} helpchooser_demobadge, tool_sherpa {{/str}}</span>
        <h6 class="card-title mt-1 mb-1">{{title}}</h6>
        <p class="card-text small text-muted mb-0">{{summary}}</p>
    </div>
</div>
